{
  "name": "WebExecutionRequest",
  "type": "object",
  "properties": {
    "batch_id": {
      "description": "Agrupa varias requests da MESMA pergunta do chat (ex: 3 sites numa pergunta). Equivale a request_group_id.",
      "type": "string"
    },
    "capability_id": {
      "description": "ID da capability sendo executada (ex: product.search)",
      "type": "string"
    },
    "chat_session_id": {
      "description": "Session de chat para onde a resposta final deve ser postada quando o batch terminar. Equivale a conversation_id.",
      "type": "string"
    },
    "completed_at": {
      "format": "date-time",
      "type": "string"
    },
    "discovered_from_url": {
      "description": "URL da pagina onde a capability foi descoberta (onde a extensao deve navegar)",
      "type": "string"
    },
    "error": {
      "description": "Mensagem de erro quando status=failed",
      "type": "string"
    },
    "input_fields": {
      "description": "JSON array dos nomes de campo a preencher",
      "type": "string"
    },
    "inputs": {
      "description": "JSON object com os valores a preencher em cada campo",
      "type": "string"
    },
    "requested_at": {
      "format": "date-time",
      "type": "string"
    },
    "result": {
      "description": "JSON com o resultado (snapshot/links) quando status=completed",
      "type": "string"
    },
    "site_url": {
      "description": "URL base do site (para compor a resposta final)",
      "type": "string"
    },
    "status": {
      "default": "pending",
      "description": "pending = aguardando extensao pegar; in_progress = extensao executando (claimada); completed/failed = terminado",
      "enum": [
        "pending",
        "in_progress",
        "completed",
        "failed"
      ],
      "type": "string"
    },
    "web_session_id": {
      "description": "WebSession (source=extension) alvo desta execucao",
      "type": "string"
    },
    "workspace_id": {
      "description": "ID do workspace de origem. pollTasks valida que a sessao/bridge solicitante pertence ao mesmo workspace + usuario. Preenchido server-side pelo planner (resolve do active_workspace_id).",
      "type": "string"
    },
    "bridge_id": {
      "description": "ID da bridge (extensao) que deve executar esta tarefa. Preenchido pelo planner a partir do WebSession.bridge_id. pollTasks valida que a bridge solicitante bate.",
      "type": "string"
    },
    "browser_session_id": {
      "description": "ID da sessao de browser (aba) que deve executar. Derivado do WebSession.browser_session_id. Usado para serializacao de tarefas na mesma aba.",
      "type": "string"
    },
    "connector_id": {
      "description": "ID logico do connector web ('web-connector'). Preenchido pelo planner. Autorizacao contextual de execucao via connectorWorkspace.authorizeExecution.",
      "type": "string"
    },
    "claimed_by": {
      "description": "bridge_id que fez o claim atomico da tarefa (pollTasks). completeTask valida que quem conclui == quem claimou. Prevencao contra conclusao por bridge errado.",
      "type": "string"
    },
    "claimed_at": {
      "description": "Timestamp do claim atomico. Permite detectar claims abandonados (in_progress sem completed por muito tempo) e reatribuir.",
      "format": "date-time",
      "type": "string"
    }
  },
  "required": [
    "web_session_id",
    "batch_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}