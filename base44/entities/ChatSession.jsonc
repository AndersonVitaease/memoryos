{
  "name": "ChatSession",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "T\u00edtulo da sess\u00e3o (auto-gerado)"
    },
    "summary": {
      "type": "string",
      "description": "Resumo incremental atualizado a cada lote de mensagens"
    },
    "project_id": {
      "type": "string",
      "description": "Projeto relacionado (opcional)"
    },
    "workspace_id": {
      "type": "string",
      "description": "ID do workspace. Null durante migracao. Acesso decidido por RLS (created_by_id OU workspace_id in user.workspace_ids)."
    },
    "scope": {
      "type": "string",
      "enum": [
        "personal",
        "workspace",
        "session"
      ],
      "default": "personal",
      "description": "Classificacao de memoria (NAO mecanismo de seguranca). Seguranca via RLS + membership. 'personal' = privada do dono; 'workspace' = compartilhada no workspace; 'session' = efemera da sessao."
    },
    "message_count": {
      "type": "number",
      "default": 0,
      "description": "Contagem de mensagens"
    },
    "last_message_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data da \u00faltima mensagem"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "historical",
        "archived"
      ],
      "default": "active",
      "description": "Camada de mem\u00f3ria"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.workspace_id": "{{user.data.active_workspace_id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}