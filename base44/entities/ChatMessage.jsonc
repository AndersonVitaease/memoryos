{
  "name": "ChatMessage",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto ao qual pertence"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ],
      "description": "Quem enviou a mensagem"
    },
    "content": {
      "type": "string",
      "description": "Conte\u00fado da mensagem"
    },
    "sources_used": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos documentos usados como contexto"
    }
  },
  "required": [
    "project_id",
    "role",
    "content"
  ]
}