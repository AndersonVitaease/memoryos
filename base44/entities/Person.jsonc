{
  "name": "Person",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto ao qual pertence"
    },
    "workspace_id": {
      "type": "string",
      "description": "ID do workspace. Null durante migracao."
    },
    "name": {
      "type": "string",
      "description": "Nome da pessoa"
    },
    "role": {
      "type": "string",
      "enum": [
        "cliente",
        "fornecedor",
        "funcionario",
        "parceiro",
        "outro"
      ],
      "default": "cliente",
      "description": "Rela\u00e7\u00e3o com o projeto"
    },
    "email": {
      "type": "string",
      "description": "Email de contato"
    },
    "phone": {
      "type": "string",
      "description": "Telefone de contato"
    },
    "notes": {
      "type": "string",
      "description": "Notas sobre a pessoa"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs das tags associadas"
    }
  },
  "required": [
    "project_id",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}