{
  "name": "InteractionEvent",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Sessao de chat de origem (isolamento por usuario/sessao)"
    },
    "correlation_id": {
      "type": "string",
      "description": "ID de execucao/correlacao. Para eventos actor=user, e o executionId do pipeline. Para actor=system, e o ID do evento sistemico correspondente."
    },
    "actor": {
      "type": "string",
      "enum": [
        "user",
        "system"
      ],
      "description": "Quem originou o evento. user = acao do usuario. system = acao do MemoryOS."
    },
    "event_type": {
      "type": "string",
      "description": "Tipo do evento. Exemplos actor=user: message_sent, message_repeated, session_idle, session_abandoned. Exemplos actor=system: capability_executed, watch_triggered, event_emitted."
    },
    "intent_hash": {
      "type": "string",
      "description": "Hash deterministico da intencao normalizada (FNV-1a 32-bit, hex). Null para eventos sem texto de intencao."
    },
    "raw_text": {
      "type": "string",
      "description": "Texto bruto do evento truncado em 4000 chars. Null para eventos sem texto."
    },
    "payload": {
      "type": "string",
      "description": "JSON serializado de contexto adicional deterministico. Opcional."
    }
  },
  "required": [
    "session_id",
    "actor",
    "event_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}