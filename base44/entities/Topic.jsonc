{
  "name": "Topic",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Sess\u00e3o onde o assunto surgiu"
    },
    "project_id": {
      "type": "string",
      "description": "Projeto relacionado (opcional)"
    },
    "workspace_id": {
      "type": "string",
      "description": "ID do workspace. Null durante migracao."
    },
    "scope": {
      "type": "string",
      "enum": [
        "personal",
        "workspace",
        "session"
      ],
      "default": "personal",
      "description": "Classificacao de memoria (NAO seguranca)."
    },
    "name": {
      "type": "string",
      "description": "Nome do assunto/tema"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do assunto"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "historical",
        "archived"
      ],
      "default": "active",
      "description": "Estado do assunto"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}