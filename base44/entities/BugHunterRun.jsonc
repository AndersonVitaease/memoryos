{
  "name": "BugHunterRun",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "description": "ID unico da execucao (correlaciona com BugFinding.run_id). Estavel entre chunks no modo continuo."
    },
    "target_url": {
      "type": "string",
      "description": "URL alvo testada"
    },
    "mode": {
      "type": "string",
      "enum": [
        "explore",
        "conversation"
      ],
      "description": "Modo de execucao"
    },
    "scenario": {
      "type": "string",
      "description": "Cenario guia (vazio se exploracao livre)"
    },
    "max_steps": {
      "type": "number",
      "description": "Limite de passos configurado por chunk"
    },
    "steps_executed": {
      "type": "number",
      "description": "Passos realmente executados (acumulado entre chunks)"
    },
    "questions_sent": {
      "type": "number",
      "default": 0,
      "description": "Perguntas enviadas ao chat (acumulado entre chunks)"
    },
    "questions_answered": {
      "type": "number",
      "default": 0,
      "description": "Perguntas enviadas E com resposta lida. Acumulado entre chunks."
    },
    "findings_count": {
      "type": "number",
      "default": 0,
      "description": "Total de BugFindings criados (acumulado entre chunks)"
    },
    "transcript": {
      "type": "string",
      "description": "JSON array de {step, question, response_evidence, read_step}. Acumulado entre chunks."
    },
    "history": {
      "type": "string",
      "description": "JSON serializado do historico de acoes (do ultimo chunk)"
    },
    "duration_ms": {
      "type": "number",
      "description": "Duracao total acumulada em ms (entre chunks)"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "awaiting_next_chunk",
        "completed",
        "stopped",
        "failed"
      ],
      "default": "running",
      "description": "Estado da run."
    },
    "stop_requested": {
      "type": "boolean",
      "default": false,
      "description": "Sinalizado pelo usuario (botao Parar) para interromper o loop."
    },
    "chat_session_id": {
      "type": "string",
      "description": "ID da sessao de chat do MemoryOS usada nesta run."
    },
    "target_questions": {
      "type": "number",
      "default": 0,
      "description": "Meta total de perguntas respondidas. 0 = modo continuo ate o usuario parar."
    },
    "chunk_count": {
      "type": "number",
      "default": 0,
      "description": "Quantos chunks ja rodaram nesta run."
    },
    "continuous": {
      "type": "boolean",
      "default": false,
      "description": "Se true, roda em modo continuo encadeado."
    }
  },
  "required": [
    "run_id",
    "target_url",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}