{
  "name": "KnowledgeObservation",
  "type": "object",
  "properties": {
    "target_object_id": {
      "type": "string",
      "description": "ID do objeto de conhecimento alvo (ex: session_id, document_id, entity_id)"
    },
    "target_object_type": {
      "type": "string",
      "description": "Tipo do objeto alvo (ex: session, message, document, entity)"
    },
    "nature": {
      "type": "string",
      "enum": [
        "Evidence",
        "Inference",
        "Hypothesis"
      ],
      "description": "Natureza epistemica da observacao"
    },
    "payload_type": {
      "type": "string",
      "description": "Chave do schema do payload (ex: conversation_turn, entity_mention, topic_signal)"
    },
    "data": {
      "type": "string",
      "description": "Payload JSON serializado da observacao"
    },
    "dependency_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de observacoes das quais esta depende (para deteccao de ciclos)"
    },
    "context_scope": {
      "type": "string",
      "description": "Namespace de isolamento (ex: session, project, global)"
    },
    "session_id": {
      "type": "string",
      "description": "Sessao de origem"
    },
    "project_id": {
      "type": "string",
      "description": "Projeto de origem (opcional)"
    },
    "confidence": {
      "type": "number",
      "description": "Score de confianca 0.0 a 1.0"
    },
    "is_refuted": {
      "type": "boolean",
      "default": false,
      "description": "Se true, esta observacao foi invalidada por outra posterior"
    },
    "refuted_by_id": {
      "type": "string",
      "description": "ID da observacao que refutou esta (quando is_refuted=true)"
    },
    "producer_id": {
      "type": "string",
      "description": "ID do modulo/engine que gerou esta observacao"
    },
    "execution_id": {
      "type": "string",
      "description": "ID da execucao da pipeline que originou esta observacao"
    }
  },
  "required": [
    "target_object_id",
    "target_object_type",
    "nature",
    "payload_type",
    "data",
    "context_scope",
    "confidence",
    "producer_id"
  ]
}