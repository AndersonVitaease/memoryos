{
  "name": "CapabilityCandidate",
  "type": "object",
  "properties": {
    "web_session_id": {
      "type": "string",
      "description": "Sessao usada na exploracao que originou este candidato"
    },
    "site_url": {
      "type": "string",
      "description": "URL base do sistema conectado"
    },
    "suggested_id": {
      "type": "string",
      "description": "ID sugerido da capability (ex: 'reservation.search', 'passenger.search', 'listing.create'). Original, preservado durante consolidacao."
    },
    "description": {
      "type": "string",
      "description": "Descricao curta do que a capability faz, inferida pelo LLM. Original, preservada durante consolidacao."
    },
    "evidence": {
      "type": "string",
      "description": "JSON array de objetos de evidencia. Cada evidencia: { element_ref, element (dados reais do DOM recuperados do snapshot por ref, ou null), snapshot_ref_found, page_url, page_index, action_inferred, source, has_write_actions }. Evidencia da observacao, nao codigo executavel. Crece com cada consolidacao (append, nunca overwrite)."
    },
    "input_fields": {
      "type": "string",
      "description": "JSON array dos campos de entrada identificados no formulario (nome/label/tipo). Estrutura da operacao."
    },
    "discovered_from_url": {
      "type": "string",
      "description": "URL da primeira pagina onde o candidato foi encontrado. URLs subsequentes (consolidadas) ficam em evidence[].page_url."
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "validating",
        "validated",
        "rejected"
      ],
      "default": "candidate",
      "description": "candidate = recem-descoberto; validating = em validacao read-only; validated = promovido para CapabilityMap; rejected = falso-positivo ou invalido"
    },
    "validation_notes": {
      "type": "string",
      "description": "Notas da validacao (o que foi checado, por que foi validado ou rejeitado)"
    },
    "rejected_reason": {
      "type": "string",
      "description": "Motivo da rejeicao quando status=rejected (ex: 'botao decorativo', 'nao e formulario', 'requer escrita')"
    },
    "canonical_id": {
      "type": "string",
      "description": "ID canonico normalizado (lowercase, sinonimos PT/EN, singular). Usado para deduplication. Ex: 'product.search'. Null em registros legados (pre-Passo-2)."
    },
    "identity_hash": {
      "type": "string",
      "description": "Hash deterministico de (site_origin + canonical_id + inputs_canonizados_ordenados). Usado para deduplication exata. Null em registros legados (pre-Passo-2)."
    },
    "consolidated_count": {
      "type": "number",
      "default": 1,
      "description": "Quantas descobertas foram consolidadas nesta candidate. 1 = descoberta unica. Incrementa a cada consolidacao."
    },
    "capability_type": {
      "type": "string",
      "enum": [
        "READ",
        "WRITE"
      ],
      "default": "READ",
      "description": "Natureza da capability. READ = consulta/listagem/filtro/visualizacao (nao altera estado). WRITE = criar/editar/cancelar/envio/exclusao/publicacao/acao (altera estado). Default READ para compatibilidade com registros legados pre-evolucao. O LLM classifica no momento da descoberta; o determinismo do canonical_id (verbo) diferencia READ de WRITE sem colidir no identity_hash."
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "safe",
        "reversible",
        "irreversible"
      ],
      "default": "safe",
      "description": "Nivel de risco da capability (reusa o tipo Reversibility do ConnectorTypes). safe = sem efeito colateral (tipicamente READ). reversible = altera estado mas pode ser desfeito trivialmente. irreversible = altera estado sem desfazer trivial. Default safe para compatibilidade. SafetyGate le este campo na fase de execucao (nao na descoberta)."
    }
  },
  "required": [
    "site_url",
    "suggested_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {},
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}