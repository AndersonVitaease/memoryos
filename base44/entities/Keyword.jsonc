{
  "name": "Keyword",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "description": "ID do documento de origem"
    },
    "message_id": {
      "type": "string",
      "description": "ID da mensagem de origem"
    },
    "session_id": {
      "type": "string",
      "description": "Sess\u00e3o de origem"
    },
    "project_id": {
      "type": "string",
      "description": "ID do projeto"
    },
    "workspace_id": {
      "type": "string",
      "description": "ID do workspace. Null durante migracao."
    },
    "scope": {
      "type": "string",
      "enum": [
        "personal",
        "workspace",
        "session"
      ],
      "default": "personal",
      "description": "Classificacao de memoria (NAO seguranca)."
    },
    "source_type": {
      "type": "string",
      "enum": [
        "document",
        "message"
      ],
      "default": "document",
      "description": "Origem da palavra-chave"
    },
    "keyword": {
      "type": "string",
      "description": "Palavra-chave"
    }
  },
  "required": [
    "source_type",
    "keyword"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}