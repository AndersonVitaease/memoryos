{
  "name": "Keyword",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "description": "ID do documento de origem"
    },
    "message_id": {
      "type": "string",
      "description": "ID da mensagem de origem"
    },
    "session_id": {
      "type": "string",
      "description": "Sess\u00e3o de origem"
    },
    "project_id": {
      "type": "string",
      "description": "ID do projeto"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "document",
        "message"
      ],
      "default": "document",
      "description": "Origem da palavra-chave"
    },
    "keyword": {
      "type": "string",
      "description": "Palavra-chave"
    }
  },
  "required": [
    "source_type",
    "keyword"
  ]
}