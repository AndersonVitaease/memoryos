{
  "name": "Document",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "ID do projeto ao qual pertence (opcional)"
    },
    "workspace_id": {
      "type": "string",
      "description": "ID do workspace. Null durante migracao."
    },
    "scope": {
      "type": "string",
      "enum": [
        "personal",
        "workspace",
        "session"
      ],
      "default": "personal",
      "description": "Classificacao de memoria (NAO seguranca)."
    },
    "session_id": {
      "type": "string",
      "description": "ID da sess\u00e3o de chat onde o conte\u00fado foi adicionado"
    },
    "folder_id": {
      "type": "string",
      "description": "ID da pasta onde o arquivo est\u00e1 organizado"
    },
    "name": {
      "type": "string",
      "description": "Nome do arquivo ou t\u00edtulo do conte\u00fado"
    },
    "file_url": {
      "type": "string",
      "description": "URL do arquivo armazenado"
    },
    "file_type": {
      "type": "string",
      "enum": [
        "pdf",
        "docx",
        "txt",
        "image",
        "spreadsheet",
        "audio",
        "link",
        "text",
        "other"
      ],
      "description": "Tipo do conte\u00fado"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "file",
        "link",
        "text"
      ],
      "default": "file",
      "description": "Origem do conte\u00fado"
    },
    "original_url": {
      "type": "string",
      "description": "URL original (para links)"
    },
    "extracted_text": {
      "type": "string",
      "description": "Texto extra\u00eddo do conte\u00fado para busca"
    },
    "size_bytes": {
      "type": "number",
      "description": "Tamanho do arquivo em bytes"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs das tags associadas"
    },
    "summary": {
      "type": "string",
      "description": "Resumo inteligente do conte\u00fado gerado pela IA"
    },
    "processing_status": {
      "type": "string",
      "enum": [
        "pending",
        "processing",
        "completed",
        "failed"
      ],
      "default": "pending",
      "description": "Status do processamento"
    },
    "category": {
      "type": "string",
      "enum": [
        "contrato",
        "financeiro",
        "marketing",
        "produto",
        "juridico",
        "comercial",
        "atendimento",
        "reuniao",
        "planejamento",
        "outro"
      ],
      "description": "Categoria do documento classificada automaticamente"
    }
  },
  "required": [
    "name",
    "file_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}