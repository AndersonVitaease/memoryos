{
  "name": "Workspace",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do workspace"
    },
    "description": {
      "type": "string",
      "description": "Descricao do workspace"
    },
    "type": {
      "type": "string",
      "enum": [
        "pessoal",
        "empresa",
        "equipe"
      ],
      "default": "pessoal",
      "description": "Tipo do workspace. 'pessoal' = workspace individual automatico; 'empresa'/'equipe' = compartilhado."
    },
    "owner_id": {
      "type": "string",
      "description": "ID do usuario proprietario (criador). Igual a created_by_id."
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "pro",
        "business"
      ],
      "default": "free",
      "description": "Plano do workspace"
    },
    "icon": {
      "type": "string",
      "description": "Icone do workspace"
    },
    "color": {
      "type": "string",
      "description": "Cor de identificacao visual"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}