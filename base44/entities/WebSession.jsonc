{
  "name": "WebSession",
  "properties": {
    "browser_context_id": {
      "description": "ID do contexto Playwright associado, para reuso (headless/live); para extension armazena o tabId da aba Chrome",
      "type": "string"
    },
    "cookies": {
      "description": "JSON serializado dos cookies capturados. Nunca armazenar senha, email de login, ou qualquer credencial - ver ADR-019.",
      "type": "string"
    },
    "error_message": {
      "description": "Detalhe do erro quando status=failed",
      "type": "string"
    },
    "expires_at": {
      "description": "TTL da sessao - reautenticacao manual solicitada apos expirar",
      "format": "date-time",
      "type": "string"
    },
    "last_used_at": {
      "description": "Ultima vez que esta sessao foi reutilizada com sucesso (ou heartbeat da extensao)",
      "format": "date-time",
      "type": "string"
    },
    "site_name": {
      "description": "Nome legivel (ex: 'Wooba', 'CRM interno')",
      "type": "string"
    },
    "site_url": {
      "description": "URL base do sistema conectado",
      "type": "string"
    },
    "source": {
      "description": "Origem da sessao: 'headless' = Playwright MCP (automacao DOM); 'live' = Selenium/noVNC (login manual humano); 'extension' = extensao Chrome na aba ativa do usuario (passa por anti-bot como Cloudflare nativamente). Default 'headless' preserva comportamento das sessoes existentes.",
      "enum": [
        "headless",
        "live",
        "extension"
      ],
      "default": "headless",
      "type": "string"
    },
    "status": {
      "default": "pending_login",
      "description": "pending_login = aguardando o usuario confirmar login manual; active = sessao capturada e reutilizavel; expired = TTL vencido, requer novo login; revoked = usuario desconectou; failed = site bloqueou automacao ou outro erro irrecuperavel",
      "enum": [
        "pending_login",
        "active",
        "expired",
        "revoked",
        "failed"
      ],
      "type": "string"
    }
  },
  "required": [
    "site_url",
    "status"
  ],
  "rls": {
    "delete": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    }
  },
  "type": "object"
}