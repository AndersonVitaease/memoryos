{
  "name": "WebSession",
  "type": "object",
  "properties": {
    "browser_context_id": {
      "description": "ID do contexto Playwright associado, para reuso (headless/live); para extension armazena o tabId da aba Chrome",
      "type": "string"
    },
    "cookies": {
      "description": "JSON serializado dos cookies capturados. Nunca armazenar senha, email de login, ou qualquer credencial - ver ADR-019.",
      "type": "string"
    },
    "error_message": {
      "description": "Detalhe do erro quando status=failed",
      "type": "string"
    },
    "expires_at": {
      "description": "TTL da sessao - reautenticacao manual solicitada apos expirar",
      "format": "date-time",
      "type": "string"
    },
    "last_used_at": {
      "description": "Ultima vez que esta sessao foi reutilizada com sucesso (ou heartbeat da extensao)",
      "format": "date-time",
      "type": "string"
    },
    "site_name": {
      "description": "Nome legivel (ex: 'Wooba', 'CRM interno')",
      "type": "string"
    },
    "site_url": {
      "description": "URL base do sistema conectado",
      "type": "string"
    },
    "source": {
      "description": "Origem da sessao: 'headless' = Playwright MCP; 'live' = Selenium/noVNC; 'extension' = extensao Chrome. Default 'headless'.",
      "enum": [
        "headless",
        "live",
        "extension"
      ],
      "default": "headless",
      "type": "string"
    },
    "status": {
      "default": "pending_login",
      "description": "pending_login = aguardando login; active = capturada e reutilizavel; expired = TTL vencido; revoked = desconectado; failed = bloqueado",
      "enum": [
        "pending_login",
        "active",
        "expired",
        "revoked",
        "failed"
      ],
      "type": "string"
    },
    "workspace_id": {
      "description": "ID do workspace dono da sessao. Sessao web e PRIVADA por usuario (RLS por created_by_id); workspace_id e metadata para pollTasks validar contexto.",
      "type": "string"
    },
    "bridge_id": {
      "description": "ID estavel da instancia do MemoryOS Bridge (extensao Chrome) que detem esta sessao. pollTasks valida que a bridge solicitante bate com a bridge da sessao.",
      "type": "string"
    },
    "browser_session_id": {
      "description": "ID da sessao de browser (tabId Chrome para extension, contextId para Playwright). Composta com bridge_id valida que a tarefa roda na aba certa.",
      "type": "string"
    }
  },
  "required": [
    "site_url",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}