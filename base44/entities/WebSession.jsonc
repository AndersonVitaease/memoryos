{
  "name": "WebSession",
  "properties": {
    "browser_context_id": {
      "description": "ID do contexto Playwright associado, para reuso",
      "type": "string"
    },
    "cookies": {
      "description": "JSON serializado dos cookies capturados. Nunca armazenar senha, email de login, ou qualquer credencial \u2014 ver ADR-019.",
      "type": "string"
    },
    "error_message": {
      "description": "Detalhe do erro quando status=failed",
      "type": "string"
    },
    "expires_at": {
      "description": "TTL da sess\u00e3o \u2014 reautentica\u00e7\u00e3o manual solicitada ap\u00f3s expirar",
      "format": "date-time",
      "type": "string"
    },
    "last_used_at": {
      "description": "\u00daltima vez que esta sess\u00e3o foi reutilizada com sucesso",
      "format": "date-time",
      "type": "string"
    },
    "site_name": {
      "description": "Nome leg\u00edvel (ex: 'Wooba', 'CRM interno')",
      "type": "string"
    },
    "site_url": {
      "description": "URL base do sistema conectado",
      "type": "string"
    },
    "status": {
      "default": "pending_login",
      "description": "pending_login = aguardando o usu\u00e1rio confirmar login manual; active = sess\u00e3o capturada e reutiliz\u00e1vel; expired = TTL vencido, requer novo login; revoked = usu\u00e1rio desconectou; failed = site bloqueou automa\u00e7\u00e3o ou outro erro irrecuper\u00e1vel",
      "enum": [
        "pending_login",
        "active",
        "expired",
        "revoked",
        "failed"
      ],
      "type": "string"
    }
  },
  "required": [
    "site_url",
    "status"
  ],
  "rls": {
    "delete": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    }
  },
  "type": "object"
}