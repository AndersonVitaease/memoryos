{
  "name": "OfficialDocCache",
  "type": "object",
  "properties": {
    "search_term": {
      "type": "string",
      "description": "Termo/assunto que originou esse fato (ex: 'Mercado Livre API limite requisições')"
    },
    "fact": {
      "type": "string",
      "description": "O fato/informação em si, em texto objetivo"
    },
    "source_url": {
      "type": "string",
      "description": "URL da fonte de onde o fato veio, se disponível"
    },
    "source_name": {
      "type": "string",
      "description": "Nome legível da fonte (ex: 'Mercado Livre Developers')"
    }
  },
  "required": [
    "search_term",
    "fact"
  ]
}
