{
  "name": "Message",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "ID da sess\u00e3o de chat"
    },
    "project_id": {
      "type": "string",
      "description": "ID do projeto (opcional, para isolamento)"
    },
    "workspace_id": {
      "type": "string",
      "description": "ID do workspace. Null durante migracao."
    },
    "scope": {
      "type": "string",
      "enum": [
        "personal",
        "workspace",
        "session"
      ],
      "default": "personal",
      "description": "Classificacao de memoria (NAO seguranca)."
    },
    "conversation_id": {
      "type": "string",
      "description": "ID da conversa (legado)"
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "assistant"
      ],
      "description": "Autor: usu\u00e1rio ou IA"
    },
    "content": {
      "type": "string",
      "description": "Texto da mensagem"
    },
    "topic_id": {
      "type": "string",
      "description": "Assunto relacionado (auto-detectado)"
    },
    "memory_tier": {
      "type": "string",
      "enum": [
        "active",
        "historical",
        "archived"
      ],
      "default": "active",
      "description": "Camada de mem\u00f3ria"
    },
    "sources_used": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs de documentos/conhecimento usados como contexto"
    }
  },
  "required": [
    "session_id",
    "role",
    "content"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "data.workspace_id": "{{user.data.active_workspace_id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}