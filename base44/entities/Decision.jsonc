{
  "name": "Decision",
  "type": "object",
  "properties": {
    "session_id": {
      "type": "string",
      "description": "Sess\u00e3o onde a decis\u00e3o foi tomada"
    },
    "project_id": {
      "type": "string",
      "description": "Projeto relacionado (opcional)"
    },
    "title": {
      "type": "string",
      "description": "T\u00edtulo da decis\u00e3o"
    },
    "description": {
      "type": "string",
      "description": "Detalhes da decis\u00e3o"
    },
    "decided_date": {
      "type": "string",
      "format": "date",
      "description": "Data em que a decis\u00e3o foi tomada"
    },
    "rationale": {
      "type": "string",
      "description": "Raz\u00e3o/contexto da decis\u00e3o"
    }
  },
  "required": [
    "title"
  ]
}