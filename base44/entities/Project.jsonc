{
  "name": "Project",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Nome do projeto"
    },
    "description": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do projeto"
    },
    "type": {
      "type": "string",
      "enum": [
        "pessoal",
        "empresa",
        "condominio",
        "turismo",
        "outro"
      ],
      "default": "pessoal",
      "description": "Tipo do projeto"
    },
    "color": {
      "type": "string",
      "description": "Cor do projeto para identifica\u00e7\u00e3o visual"
    },
    "icon": {
      "type": "string",
      "description": "\u00cdcone do projeto"
    },
    "workspace_id": {
      "type": "string",
      "description": "ID do workspace ao qual o projeto pertence. Projeto e sub-organizacao DENTRO do workspace. Null durante a migracao (backfill atribui ao workspace pessoal do dono)."
    },
    "file_count": {
      "type": "number",
      "default": 0,
      "description": "Contagem de arquivos no projeto"
    },
    "message_count": {
      "type": "number",
      "default": 0,
      "description": "Contagem de mensagens no projeto"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}