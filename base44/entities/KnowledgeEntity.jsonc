{
  "name": "KnowledgeEntity",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "description": "ID do documento de origem (se veio de documento)"
    },
    "message_id": {
      "type": "string",
      "description": "ID da mensagem de origem (se veio de conversa)"
    },
    "session_id": {
      "type": "string",
      "description": "Sess\u00e3o de origem (se veio de conversa)"
    },
    "project_id": {
      "type": "string",
      "description": "ID do projeto (isolamento)"
    },
    "source_type": {
      "type": "string",
      "enum": [
        "document",
        "message"
      ],
      "default": "document",
      "description": "Origem do conhecimento"
    },
    "type": {
      "type": "string",
      "enum": [
        "pessoa",
        "empresa",
        "organizacao",
        "produto",
        "local",
        "data",
        "horario",
        "numero",
        "valor_monetario",
        "telefone",
        "email",
        "site"
      ],
      "description": "Tipo da entidade"
    },
    "value": {
      "type": "string",
      "description": "Valor da entidade"
    },
    "context": {
      "type": "string",
      "description": "Trecho onde a entidade foi mencionada"
    },
    "memory_tier": {
      "type": "string",
      "enum": [
        "active",
        "historical",
        "archived"
      ],
      "default": "active",
      "description": "Camada de mem\u00f3ria"
    }
  },
  "required": [
    "source_type",
    "type",
    "value"
  ]
}