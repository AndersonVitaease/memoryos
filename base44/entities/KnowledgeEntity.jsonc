{
  "name": "KnowledgeEntity",
  "type": "object",
  "properties": {
    "document_id": {
      "type": "string",
      "description": "ID do documento de origem (se veio de documento)"
    },
    "message_id": {
      "type": "string",
      "description": "ID da mensagem de origem (se veio de conversa)"
    },
    "session_id": {
      "type": "string",
      "description": "Sess\u00e3o de origem (se veio de conversa)"
    },
    "project_id": {
      "type": "string",
      "description": "ID do projeto (isolamento)"
    },
    "workspace_id": {
      "type": "string",
      "description": "ID do workspace. Null durante migracao."
    },
    "scope": {
      "type": "string",
      "enum": [
        "personal",
        "workspace",
        "session"
      ],
      "default": "personal",
      "description": "Classificacao de memoria (NAO seguranca)."
    },
    "source_type": {
      "type": "string",
      "enum": [
        "document",
        "message"
      ],
      "default": "document",
      "description": "Origem do conhecimento"
    },
    "type": {
      "type": "string",
      "enum": [
        "pessoa",
        "empresa",
        "organizacao",
        "produto",
        "local",
        "data",
        "horario",
        "numero",
        "valor_monetario",
        "telefone",
        "email",
        "site"
      ],
      "description": "Tipo da entidade"
    },
    "value": {
      "type": "string",
      "description": "Valor da entidade"
    },
    "context": {
      "type": "string",
      "description": "Trecho onde a entidade foi mencionada"
    },
    "memory_tier": {
      "type": "string",
      "enum": [
        "active",
        "historical",
        "archived"
      ],
      "default": "active",
      "description": "Camada de mem\u00f3ria"
    }
  },
  "required": [
    "source_type",
    "type",
    "value"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.workspace_id": {
            "$in": "{{user.data.workspace_ids}}"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}